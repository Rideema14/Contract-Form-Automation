# Server-only backend URL. Use HTTPS outside local development.
API_BASE_URL=http://localhost:4000/api

# Server-only public origin of this frontend (scheme and host, no path).
# Leave empty locally and on Azure App Service, which provides WEBSITE_HOSTNAME.
# Set it for a custom domain or another production host, e.g. https://forms.example.com
APP_ORIGIN=

# Optional demo-only logins. These values are public in the browser bundle.
# Use disposable accounts in a non-production environment only.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_APPROVER_EMAIL=
NEXT_PUBLIC_DEMO_APPROVER_PASSWORD=
NEXT_PUBLIC_DEMO_SUBMITTER_EMAIL=
NEXT_PUBLIC_DEMO_SUBMITTER_PASSWORD=
