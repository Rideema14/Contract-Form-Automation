# Copy the backend section to backend/.env and the frontend section to frontend/.env.local
# ===== Backend (backend/.env) =====
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://contract_user:YOUR_DB_PASSWORD@localhost:5432/contract_automation?schema=public"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN=8h

# Google Drive - backend only, never in the frontend
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional for OAuth; required for service-account access to a Shared Drive
GOOGLE_DRIVE_FOLDER_ID=
# Service-account mode only; keep the key file under backend/secrets/
GOOGLE_APPLICATION_CREDENTIALS=

# Document upload policy
DOCUMENT_ALLOWED_EXTENSIONS=pdf,xlsx,xls,csv,doc,docx,png,jpg,jpeg,txt
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
DOCUMENT_MAX_FILE_COUNT=5

# Notifications (values to be confirmed with company)
NOTIFICATION_CHANNEL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ===== Frontend (frontend/.env.local) =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
