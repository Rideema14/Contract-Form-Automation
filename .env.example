# ===== Backend =====
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
JWT_SECRET=<SET_A_LONG_RANDOM_SECRET>
JWT_EXPIRES_IN=<e.g. 8h>

# Google Drive (Phase 3) - not configured yet
GOOGLE_DRIVE_CLIENT_EMAIL=<SERVICE_ACCOUNT_EMAIL>
GOOGLE_DRIVE_PRIVATE_KEY=<SERVICE_ACCOUNT_PRIVATE_KEY>
GOOGLE_DRIVE_ROOT_FOLDER_ID=<DRIVE_FOLDER_ID>

# File upload limits (values to be confirmed with company)
MAX_UPLOAD_SIZE_MB=<VALUE>

# Notifications (channel to be confirmed with company)
NOTIFICATION_CHANNEL=<in-app|email>
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=<SMTP_PORT>
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>

# Puppeteer (PDF generation)
PUPPETEER_EXECUTABLE_PATH=<OPTIONAL_PATH_TO_CHROMIUM>

# ===== Frontend =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
