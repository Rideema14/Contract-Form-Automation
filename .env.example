# Copy the backend section to backend/.env and the frontend section to frontend/.env.local
# ===== Backend (backend/.env) =====
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://contract_user:YOUR_DB_PASSWORD@localhost:5432/contract_automation?schema=public"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN=8h

# Google Drive (Phase 3) - backend only, never in the frontend
GOOGLE_APPLICATION_CREDENTIALS="./secrets/google-service-account.json"
GOOGLE_DRIVE_FOLDER_ID=""

# Upload limit / notifications (values to be confirmed with company)
MAX_UPLOAD_SIZE_MB=
NOTIFICATION_CHANNEL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ===== Frontend (frontend/.env.local) =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
