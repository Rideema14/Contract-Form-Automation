@'
# Database
DATABASE_URL="postgresql://contract_app:YOUR_DB_PASSWORD@localhost:5432/contract_automation?schema=public"

# Authentication
JWT_SECRET="replace_with_a_long_random_secret"

# Server
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"

# Optional: Initial admin account for database seeding
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
'@ | Set-Content .\backend\.env.example -Encoding utf8