NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://contract_user:YOUR_LOCAL_PASSWORD@localhost:5432/contract_automation?schema=public"
JWT_SECRET="replace-with-a-long-random-local-secret"
JWT_EXPIRES_IN=1d
# Select OAuth for a personal My Drive, or service-account for an approved Shared Drive.
GOOGLE_DRIVE_AUTH_MODE=oauth
# OAuth values are secrets; configure them only in backend/.env or a secret store.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional. With OAuth + drive.file, leave blank to create an app-owned root folder.
# Service-account mode requires an approved Shared Drive folder ID.
GOOGLE_DRIVE_FOLDER_ID=
# Service-account key path for Shared Drive deployments; keep the key under gitignored backend/secrets.
GOOGLE_APPLICATION_CREDENTIALS=

# Company-approved policy: 10 MiB/file, up to 5 files per request.
DOCUMENT_ALLOWED_EXTENSIONS=pdf,xlsx,xls,csv,docx,doc,png,jpg,jpeg,txt
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
DOCUMENT_MAX_FILE_COUNT=5