generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FormStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETURNED
}

enum EvaluationType {
  TECHNICAL
  COMMERCIAL
}

enum ApprovalStatus {
  WAITING
  PENDING
  APPROVED
  RETURNED
  REJECTED
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  RETURNED
  REJECTED
  RESUBMITTED
}

enum DocumentType {
  SUPPORTING
  COST_ESTIMATE_EXCEL
  GENERATED_PDF
}

model Role {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique
  users User[]

  @@map("roles")
}

model Department {
  id   String @id @default(uuid()) @db.Uuid
  name String

  users User[]
  forms ContractForm[] @relation("SponsorDepartment")

  @@map("departments")
}

model ContractCategory {
  id   String @id @default(uuid()) @db.Uuid
  name String

  forms ContractForm[]

  @@map("contract_categories")
}

model VendorType {
  id      String   @id @default(uuid()) @db.Uuid
  name    String
  vendors Vendor[]

  @@map("vendor_types")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  roleId       String   @map("role_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role              Role              @relation(fields: [roleId], references: [id])
  department        Department?       @relation(fields: [departmentId], references: [id])
  createdForms      ContractForm[]    @relation("FormCreator")
  assignedApprovals Approval[]        @relation("AssignedApprover")
  approvalHistory   ApprovalHistory[] @relation("HistoryActor")
  uploadedDocuments Document[]        @relation("DocumentUploader")
  auditLogs         AuditLog[]
  notifications     Notification[]    @relation("NotificationRecipient")
  evaluations       Evaluation[]      @relation("EvaluationActor")

  @@map("users")
}

model Vendor {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  vendorTypeId   String         @map("vendor_type_id") @db.Uuid
  contactDetails String?        @map("contact_details")
  createdAt      DateTime       @default(now()) @map("created_at")
  forms          ContractForm[] @relation("RecommendedVendor")
  bidders        Bidder[]
  vendorType     VendorType     @relation(fields: [vendorTypeId], references: [id])

  @@map("vendors")
}

model ContractForm {
  id                   String     @id @default(uuid()) @db.Uuid
  referenceNo          String?    @unique @map("reference_no")
  title                String?
  sponsorDepartmentId  String?    @map("sponsor_department_id") @db.Uuid
  contractCategoryId   String?    @map("contract_category_id") @db.Uuid
  scope                String?
  procurementRationale String?    @map("procurement_rationale")
  contractAmount       Decimal?   @map("contract_amount") @db.Decimal(18, 2)
  currency             String?
  recommendedVendorId  String?    @map("recommended_vendor_id") @db.Uuid
  selectionRationale   String?    @map("selection_rationale")
  status               FormStatus @default(DRAFT)
  createdById          String     @map("created_by") @db.Uuid
  submittedAt          DateTime?  @map("submitted_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  sponsorDepartment Department?        @relation("SponsorDepartment", fields: [sponsorDepartmentId], references: [id])
  category          ContractCategory?  @relation(fields: [contractCategoryId], references: [id])
  recommendedVendor Vendor?            @relation("RecommendedVendor", fields: [recommendedVendorId], references: [id])
  creator           User               @relation("FormCreator", fields: [createdById], references: [id])
  bidders           Bidder[]
  evaluations       Evaluation[]
  costEstimateItems CostEstimateItem[]
  approvals         Approval[]
  approvalHistory   ApprovalHistory[]
  documents         Document[]
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@index([status, createdById])
  @@index([sponsorDepartmentId])
  @@map("contract_forms")
}

model Bidder {
  id        String @id @default(uuid()) @db.Uuid
  formId    String @map("form_id") @db.Uuid
  vendorId  String @map("vendor_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  form        ContractForm @relation(fields: [formId], references: [id])
  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  quotations  Quotation[]
  evaluations Evaluation[]

  @@map("bidders")
}

model Quotation {
  id            String    @id @default(uuid()) @db.Uuid
  bidderId      String    @map("bidder_id") @db.Uuid
  quotedAmount  Decimal?  @map("quoted_amount") @db.Decimal(18, 2)
  currency      String?
  quotationDate DateTime? @map("quotation_date")
  notes         String?

  bidder Bidder @relation(fields: [bidderId], references: [id])

  @@map("quotations")
}

model Evaluation {
  id            String         @id @default(uuid()) @db.Uuid
  formId        String         @map("form_id") @db.Uuid
  bidderId      String         @map("bidder_id") @db.Uuid
  type          EvaluationType
  score         Decimal?       @db.Decimal(8, 2)
  remarks       String?
  evaluatedById String?        @map("evaluated_by") @db.Uuid

  form        ContractForm @relation(fields: [formId], references: [id])
  bidder      Bidder       @relation(fields: [bidderId], references: [id])
  evaluatedBy User?        @relation("EvaluationActor", fields: [evaluatedById], references: [id])

  @@map("evaluations")
}

model CostEstimateItem {
  id          String   @id @default(uuid()) @db.Uuid
  formId      String   @map("form_id") @db.Uuid
  description String
  quantity    Decimal? @db.Decimal(18, 2)
  unitCost    Decimal? @map("unit_cost") @db.Decimal(18, 2)
  amount      Decimal  @db.Decimal(18, 2)
  sortOrder   Int      @default(0) @map("sort_order")

  form ContractForm @relation(fields: [formId], references: [id])

  @@map("cost_estimate_items")
}

model Approval {
  id         String         @id @default(uuid()) @db.Uuid
  formId     String         @map("form_id") @db.Uuid
  level      Int
  approverId String         @map("approver_id") @db.Uuid
  status     ApprovalStatus @default(WAITING)
  actedAt    DateTime?      @map("acted_at")

  form     ContractForm      @relation(fields: [formId], references: [id])
  approver User              @relation("AssignedApprover", fields: [approverId], references: [id])
  history  ApprovalHistory[]

  @@index([approverId, status])
  @@map("approvals")
}

model ApprovalHistory {
  id         String         @id @default(uuid()) @db.Uuid
  approvalId String         @map("approval_id") @db.Uuid
  formId     String         @map("form_id") @db.Uuid
  actorId    String         @map("actor_id") @db.Uuid
  action     ApprovalAction
  comment    String?
  createdAt  DateTime       @default(now()) @map("created_at")

  approval Approval     @relation(fields: [approvalId], references: [id])
  form     ContractForm @relation(fields: [formId], references: [id])
  actor    User         @relation("HistoryActor", fields: [actorId], references: [id])

  @@map("approval_history")
}

model Document {
  id          String       @id @default(uuid()) @db.Uuid
  formId      String       @map("form_id") @db.Uuid
  type        DocumentType
  fileName    String       @map("file_name")
  mimeType    String       @map("mime_type")
  sizeBytes   BigInt       @map("size_bytes")
  driveFileId String       @map("drive_file_id")
  uploadedBy  String       @map("uploaded_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  form     ContractForm @relation(fields: [formId], references: [id])
  uploader User         @relation("DocumentUploader", fields: [uploadedBy], references: [id])

  @@map("documents")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  formId     String?  @map("form_id") @db.Uuid
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User          @relation(fields: [actorId], references: [id])
  form  ContractForm? @relation(fields: [formId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  recipientId String   @map("recipient_id") @db.Uuid
  formId      String?  @map("form_id") @db.Uuid
  message     String
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  channel     String?

  recipient User          @relation("NotificationRecipient", fields: [recipientId], references: [id])
  form      ContractForm? @relation(fields: [formId], references: [id])

  @@map("notifications")
}
